  @desc("Domain")
domain   demo.user

import common.types   as common
import common.auth

@desc("Status")
pub enum Status{
@desc("Enabled")
ENABLED
DISABLED
}

pub data Page <TItem>{
items:list < TItem? >
metadata:map<string,json>?
}

pub config DatabaseConfig eternal{
url:string
}

pub event CreatedEvent{
payload{
id:uuid
}
}

pub actor ClientActor{
via client { }
auth{
credential{
subject:string
}
info{
roles:list<string>
}
}
permission { }
}

pub resource User{
check byId{
input{
id:uuid
tenantId:string
}
}
action read
@desc("Update")
action update{
check owner{
input{
id:uuid
}
}
}
}

pub service UserService{
for ClientActor via client
auth

require any(
User:read,
User:update:owner(actor.info.subject)
)
@desc("Get user")
method get{
noauth
input{
@desc("User identifier")
@example("42")
id:uuid
}
output Page < common.User? > ?
}
}

task RefreshTask{
@desc("Daily")
trigger daily{
input{
at:localdatetime
}
}
}

web PortalWeb{
for ClientActor via openapi
}
